diff --git a/ssl/internal.h b/ssl/internal.h
index 74c6c2e9c..3d7c9b2f4 100644
--- a/ssl/internal.h
+++ b/ssl/internal.h
@@ -3504,6 +3504,11 @@ struct SSL_CONFIG {
   // ClientHello.
