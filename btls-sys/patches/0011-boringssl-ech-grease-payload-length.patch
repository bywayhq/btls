diff --git a/ssl/ssl_test.cc b/ssl/ssl_test.cc
index 03b67f1ed..e6dd76a9e 100644
--- a/ssl/ssl_test.cc
+++ b/ssl/ssl_test.cc
@@ -2810,6 +2810,52 @@ static bool GetECHLength(SSL_CTX *ctx, size_t *out_client_hello_len,
   return true;
 }
 
+static bool GetECHGreaseLength(std::optional<size_t> payload_length,
+                               size_t *out_ech_len) {
+  bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  bssl::UniquePtr<SSL> ssl(ctx ? SSL_new(ctx.get()) : nullptr);
+  if (!ssl) {
+    return false;
+  }
+  SSL_set_enable_ech_grease(ssl.get(), 1);
+  if (payload_length &&
+      !SSL_set_ech_grease_payload_length(ssl.get(), *payload_length)) {
+    return false;
+  }
+  SSL_set_connect_state(ssl.get());
+
+  std::vector<uint8_t> client_hello;
+  SSL_CLIENT_HELLO parsed;
+  const uint8_t *unused;
+  if (!GetClientHello(ssl.get(), &client_hello)) {
+    return false;
+  }
+  auto body =
+      Span(client_hello).subspan(SSL3_RT_HEADER_LENGTH + SSL3_HM_HEADER_LENGTH);
+  return SSL_parse_client_hello(ssl.get(), &parsed, body.data(), body.size()) &&
+         SSL_early_callback_ctx_extension_get(
+             &parsed, TLSEXT_TYPE_encrypted_client_hello, &unused, out_ech_len);
+}
+
+TEST(SSLTest, ECHGreasePayloadLength) {
+  size_t ech_len;
+  ASSERT_TRUE(GetECHGreaseLength(239, &ech_len));
+  EXPECT_EQ(281u, ech_len);
+
+  ASSERT_TRUE(GetECHGreaseLength(std::nullopt, &ech_len));
+  EXPECT_TRUE(ech_len == 186 || ech_len == 218 || ech_len == 250 ||
+              ech_len == 282)
+      << ech_len;
+
+  bssl::UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  bssl::UniquePtr<SSL> ssl(ctx ? SSL_new(ctx.get()) : nullptr);
+  ASSERT_TRUE(ssl);
+  constexpr size_t kECHGreaseExtensionOverheadForTest = 42;
+  EXPECT_FALSE(SSL_set_ech_grease_payload_length(
+      ssl.get(), UINT16_MAX - kECHGreaseExtensionOverheadForTest + 1));
+  ERR_clear_error();
+}
