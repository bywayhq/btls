 OPENSSL_EXPORT void SSL_set_enable_ech_grease(SSL *ssl, int enable);
 
+// SSL_set_ech_grease_payload_length configures the exact payload length of a
+// GREASE ECH extension. This does not enable ECH GREASE. The configured
+// payload, together with the ECHClientHelloOuter framing, must fit in a TLS
+// extension body. It returns one on success and zero on error.
+OPENSSL_EXPORT int SSL_set_ech_grease_payload_length(SSL *ssl,
+                                                     size_t payload_length);
+
 // SSL_set1_ech_config_list configures `ssl` to, as a client, offer ECH with the
 // specified configuration. `ech_config_list` should contain a serialized
 // ECHConfigList structure. It returns one on success and zero on error.
diff --git a/ssl/encrypted_client_hello.cc b/ssl/encrypted_client_hello.cc
index 46ba196f1..b534f4f33 100644
--- a/ssl/encrypted_client_hello.cc
+++ b/ssl/encrypted_client_hello.cc
@@ -729,6 +729,14 @@ static size_t random_size(size_t min, size_t max) {
   return value % (max - min + 1) + min;
 }
 
+// The ECH extension body contains an ECHClientHelloType byte followed by the
+// ECHClientHelloOuter cipher suite, config ID, X25519 encapsulated key, and
+// length-prefixed payload.
+static constexpr size_t kEchGreaseExtensionOverhead =
+    1 + 2 + 2 + 1 + 2 + X25519_PUBLIC_VALUE_LEN + 2;
+static_assert(kEchGreaseExtensionOverhead == 42,
+              "unexpected ECHClientHelloOuter overhead");
+
 static bool setup_ech_grease(SSL_HANDSHAKE *hs) {
   assert(!hs->selected_ech_config);
   if (hs->max_version < TLS1_3_VERSION || !hs->config->ech_grease_enabled) {
@@ -764,8 +772,10 @@ static bool setup_ech_grease(SSL_HANDSHAKE *hs) {
   // The server_name extension has an overhead of 9 bytes. For now, arbitrarily
   // estimate maximum_name_length to be between 32 and 100 bytes. Then round up
   // to a multiple of 32, to match RFC 9849, section 6.1.3.
-  const size_t payload_len =
-      32 * random_size(128 / 32, 224 / 32) + aead_overhead(aead);
+  const size_t payload_len = hs->config->ech_grease_payload_length
+                                 ? *hs->config->ech_grease_payload_length
+                                 : 32 * random_size(128 / 32, 224 / 32) +
+                                       aead_overhead(aead);
   bssl::ScopedCBB cbb;
   CBB enc_cbb, payload_cbb;
   uint8_t *payload;
@@ -901,6 +911,20 @@ void SSL_set_enable_ech_grease(SSL *ssl, int enable) {
   ssl_impl->config->ech_grease_enabled = !!enable;
 }
 
+int SSL_set_ech_grease_payload_length(SSL *ssl, size_t payload_length) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config) {
+    return 0;
+  }
+  if (payload_length > UINT16_MAX - kEchGreaseExtensionOverhead) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_OVERFLOW);
+    return 0;
+  }
+  ssl_impl->config->ech_grease_payload_length =
+      static_cast<uint16_t>(payload_length);
+  return 1;
+}
